#usda 1.0
(
    defaultPrim = "aid_right"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "aid_right"
{
    def "Looks"
    {
        def Material "shell"
        {
            token outputs:surface.connect = </aid_right/Looks/shell/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.72, 0.64)
                float inputs:metallic = 0
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "hook"
        {
            token outputs:surface.connect = </aid_right/Looks/hook/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.85, 0.83, 0.78)
                float inputs:metallic = 0
                float inputs:roughness = 0.2
                token outputs:surface
            }
        }

        def Material "cell"
        {
            token outputs:surface.connect = </aid_right/Looks/cell/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.7, 0.5, 0.25)
                float inputs:metallic = 0.8
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "mark"
        {
            token outputs:surface.connect = </aid_right/Looks/mark/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.25, 0.25, 0.27)
                float inputs:metallic = 0
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }
    }

    def Xform "body" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
    )
    {
        float physics:mass = 0.0024
        custom bool physxArticulation:enabledSelfCollisions = 0
        custom float physxArticulation:sleepThreshold = 0
        custom float physxArticulation:stabilizationThreshold = 0
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Mesh "shell" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysicsMeshCollisionAPI"]
        )
        {
            uniform bool doubleSided = 1
            int[] faceVertexCounts = [6, 6, 4, 4, 4, 4, 4, 4]
            int[] faceVertexIndices = [5, 4, 3, 2, 1, 0, 6, 7, 8, 9, 10, 11, 0, 1, 7, 6, 1, 2, 8, 7, 2, 3, 9, 8, 3, 4, 10, 9, 4, 5, 11, 10, 5, 0, 6, 11]
            rel material:binding = </aid_right/Looks/shell>
            uniform token physics:approximation = "convexHull"
            custom float physxCollision:contactOffset = 0.0005
            custom float physxCollision:restOffset = 0
            point3f[] points = [(0.01, -0.006, -0.0045), (0.032, -0.006, -0.0045), (0.04, -0.002, -0.0045), (0.04, 0.005, -0.0045), (0.036, 0.006, -0.0045), (0.01, 0.006, -0.0045), (0.01, -0.006, 0.0045), (0.032, -0.006, 0.0045), (0.04, -0.002, 0.0045), (0.04, 0.005, 0.0045), (0.036, 0.006, 0.0045), (0.01, 0.006, 0.0045)]
            uniform token subdivisionScheme = "none"
        }

        def Capsule "hook0" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            uniform token axis = "X"
            double height = 0.006324555320336757
            rel material:binding = </aid_right/Looks/hook>
            custom float physxCollision:contactOffset = 0.0005
            custom float physxCollision:restOffset = 0
            double radius = 0.0018
            float xformOp:rotateZ = 18.434948
            double3 xformOp:translate = (0.043, 0.001, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]
        }

        def Capsule "hook1" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            uniform token axis = "X"
            double height = 0.005656854249492383
            rel material:binding = </aid_right/Looks/hook>
            custom float physxCollision:contactOffset = 0.0005
            custom float physxCollision:restOffset = 0
            double radius = 0.0018
            float xformOp:rotateZ = 45
            double3 xformOp:translate = (0.048, 0.004, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]
        }

        def Capsule "hook2" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            uniform token axis = "X"
            double height = 0.005385164807134501
            rel material:binding = </aid_right/Looks/hook>
            custom float physxCollision:contactOffset = 0.0005
            custom float physxCollision:restOffset = 0
            double radius = 0.0018
            float xformOp:rotateZ = 68.19859
            double3 xformOp:translate = (0.051000000000000004, 0.0085, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]
        }

        def Capsule "hook3" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            uniform token axis = "X"
            double height = 0.005099019513592786
            rel material:binding = </aid_right/Looks/hook>
            custom float physxCollision:contactOffset = 0.0005
            custom float physxCollision:restOffset = 0
            double radius = 0.0018
            float xformOp:rotateZ = 101.30993
            double3 xformOp:translate = (0.0515, 0.0135, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]
        }

        def Cylinder "mark_up" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.0004
            rel material:binding = </aid_right/Looks/mark>
            double radius = 0.0018
            double3 xformOp:translate = (0.032, 0, 0.0045)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Cylinder "mark_down" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.0004
            rel material:binding = </aid_right/Looks/mark>
            double radius = 0.0018
            double3 xformOp:translate = (0.032, 0, -0.0045)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def Xform "door" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 0.0006
        double3 xformOp:translate = (0, 0.006, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Mesh "shell" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysicsMeshCollisionAPI"]
        )
        {
            uniform bool doubleSided = 1
            int[] faceVertexCounts = [5, 5, 4, 4, 4, 4, 4]
            int[] faceVertexIndices = [4, 3, 2, 1, 0, 5, 6, 7, 8, 9, 0, 1, 6, 5, 1, 2, 7, 6, 2, 3, 8, 7, 3, 4, 9, 8, 4, 0, 5, 9]
            rel material:binding = </aid_right/Looks/shell>
            uniform token physics:approximation = "convexHull"
            custom float physxCollision:contactOffset = 0.0005
            custom float physxCollision:restOffset = 0
            point3f[] points = [(0.0005, -0.012, -0.0042), (0.01, -0.012, -0.0042), (0.01, 0, -0.0042), (0, -0.0005, -0.0042), (0, -0.0105, -0.0042), (0.0005, -0.012, 0.0042), (0.01, -0.012, 0.0042), (0.01, 0, 0.0042), (0, -0.0005, 0.0042), (0, -0.0105, 0.0042)]
            uniform token subdivisionScheme = "none"
        }

        def Cube "tab" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            rel material:binding = </aid_right/Looks/shell>
            custom float physxCollision:contactOffset = 0.0005
            custom float physxCollision:restOffset = 0
            double size = 1
            float3 xformOp:scale = (0.0085, 0.0015, 0.007)
            double3 xformOp:translate = (-0.00375, -0.01125, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cylinder "cell" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.0054
            rel material:binding = </aid_right/Looks/cell>
            double radius = 0.0039
            double3 xformOp:translate = (0.006, -0.006, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def PhysicsRevoluteJoint "door_joint" (
        prepend apiSchemas = ["PhysicsDriveAPI:angular"]
    )
    {
        float drive:angular:physics:targetPosition = 0
        uniform token drive:angular:physics:type = "force"
        uniform token physics:axis = "Z"
        rel physics:body0 = </aid_right/body>
        rel physics:body1 = </aid_right/door>
        point3f physics:localPos0 = (0, 0.006, 0)
        point3f physics:localPos1 = (0, 0, 0)
        quatf physics:localRot0 = (1, 0, 0, 0)
        quatf physics:localRot1 = (1, 0, 0, 0)
        float physics:lowerLimit = -105
        float physics:upperLimit = 0
    }
}

