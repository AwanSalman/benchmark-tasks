#usda 1.0
(
    defaultPrim = "kettle"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "kettle"
{
    def "Looks"
    {
        def Material "steel"
        {
            token outputs:surface.connect = </kettle/Looks/steel/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.79, 0.8)
                float inputs:metallic = 0.8
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "inside"
        {
            token outputs:surface.connect = </kettle/Looks/inside/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.62, 0.63, 0.64)
                float inputs:metallic = 0.6
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "black"
        {
            token outputs:surface.connect = </kettle/Looks/black/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.08, 0.08, 0.09)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "pp" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.5
            float physics:restitution = 0
            float physics:staticFriction = 0.6
        }
    }

