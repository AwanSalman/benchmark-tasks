#usda 1.0
(
    defaultPrim = "nickel"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "nickel"
{
    def "Looks"
    {
        def Material "metal"
        {
            token outputs:surface.connect = </nickel/Looks/metal/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.7, 0.71, 0.73)
                float inputs:metallic = 0.8
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "phys" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.22
            float physics:restitution = 0
            float physics:staticFriction = 0.25
            custom token physxMaterial:frictionCombineMode = "max"
        }
    }

