#usda 1.0
(
    defaultPrim = "lamp"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "lamp"
{
    def "Looks"
    {
        def Material "blue"
        {
            token outputs:surface.connect = </lamp/Looks/blue/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.2, 0.32, 0.55)
                float inputs:metallic = 0.3
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "shade"
        {
            token outputs:surface.connect = </lamp/Looks/shade/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.92, 0.8)
                float inputs:metallic = 0
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }

        def Material "cord"
        {
            token outputs:surface.connect = </lamp/Looks/cord/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.12, 0.12, 0.12)
                float inputs:metallic = 0
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }

        def Material "plug"
        {
            token outputs:surface.connect = </lamp/Looks/plug/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.15, 0.15, 0.16)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "nickel"
        {
            token outputs:surface.connect = </lamp/Looks/nickel/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.75, 0.76, 0.78)
                float inputs:metallic = 0.9
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }
    }

    def Xform "base" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
    )
    {
        float physics:mass = 1
        custom bool physxArticulation:enabledSelfCollisions = 0
        custom float physxArticulation:sleepThreshold = 0
        custom float physxArticulation:stabilizationThreshold = 0
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cylinder "foot" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.02
            rel material:binding = </lamp/Looks/blue>
            custom float physxCollision:contactOffset = 0.0005
            custom float physxCollision:restOffset = 0
            double radius = 0.055
            double3 xformOp:translate = (0, 0, 0.01)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Cylinder "stem" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.22
            rel material:binding = </lamp/Looks/blue>
            double radius = 0.007
            double3 xformOp:translate = (0, 0, 0.13)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Cone "shade" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.1
            rel material:binding = </lamp/Looks/shade>
            double radius = 0.075
            double3 xformOp:translate = (0, 0, 0.26)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def Xform "c00" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 0.006
        quatf xformOp:orient = (0.16305311, 0, 0, -0.98661727)
        double3 xformOp:translate = (-0.05700000000000005, 0, 0.0039999999999998925)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

        def Capsule "tube" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            uniform token axis = "X"
            double height = 0.02458488117938374
