#usda 1.0
(
    defaultPrim = "tray"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "tray"
{
    def "Looks"
    {
        def Material "foam"
        {
            token outputs:surface.connect = </tray/Looks/foam/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.22, 0.24, 0.3)
                float inputs:metallic = 0
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }
    }

    def Xform "body" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "base" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            rel material:binding = </tray/Looks/foam>
            custom float physxCollision:contactOffset = 0.0005
            custom float physxCollision:restOffset = 0
            double size = 1
            float3 xformOp:scale = (0.07, 0.17, 0.005)
            double3 xformOp:translate = (0, 0, 0.0025000000000000005)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "top00" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            rel material:binding = </tray/Looks/foam>
            custom float physxCollision:contactOffset = 0.0005
            custom float physxCollision:restOffset = 0
            double size = 1
            float3 xformOp:scale = (0.0305, 0.17, 0.015)
            double3 xformOp:translate = (-0.01975, 0, 0.0125)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "top01" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            rel material:binding = </tray/Looks/foam>
            custom float physxCollision:contactOffset = 0.0005
            custom float physxCollision:restOffset = 0
            double size = 1
            float3 xformOp:scale = (0.009, 0.0219, 0.015)
            double3 xformOp:translate = (0, -0.07405, 0.0125)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "top02" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            rel material:binding = </tray/Looks/foam>
            custom float physxCollision:contactOffset = 0.0005
            custom float physxCollision:restOffset = 0
            double size = 1
            float3 xformOp:scale = (0.009, 0.0092, 0.015)
            double3 xformOp:translate = (0, -0.055, 0.0125)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "top03" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            rel material:binding = </tray/Looks/foam>
            custom float physxCollision:contactOffset = 0.0005
            custom float physxCollision:restOffset = 0
            double size = 1
            float3 xformOp:scale = (0.009, 0.0388, 0.015)
            double3 xformOp:translate = (0, -0.027499999999999997, 0.0125)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "top04" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            rel material:binding = </tray/Looks/foam>
            custom float physxCollision:contactOffset = 0.0005
            custom float physxCollision:restOffset = 0
            double size = 1
            float3 xformOp:scale = (0.009, 0.0092, 0.015)
            double3 xformOp:translate = (0, 0, 0.0125)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "top05" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            rel material:binding = </tray/Looks/foam>
            custom float physxCollision:contactOffset = 0.0005
            custom float physxCollision:restOffset = 0
            double size = 1
            float3 xformOp:scale = (0.009, 0.0388, 0.015)
            double3 xformOp:translate = (0, 0.027499999999999997, 0.0125)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "top06" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            rel material:binding = </tray/Looks/foam>
            custom float physxCollision:contactOffset = 0.0005
            custom float physxCollision:restOffset = 0
            double size = 1
            float3 xformOp:scale = (0.009, 0.0092, 0.015)
            double3 xformOp:translate = (0, 0.055, 0.0125)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "top07" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            rel material:binding = </tray/Looks/foam>
            custom float physxCollision:contactOffset = 0.0005
            custom float physxCollision:restOffset = 0
            double size = 1
            float3 xformOp:scale = (0.009, 0.0219, 0.015)
            double3 xformOp:translate = (0, 0.07405, 0.0125)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "top08" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            rel material:binding = </tray/Looks/foam>
            custom float physxCollision:contactOffset = 0.0005
