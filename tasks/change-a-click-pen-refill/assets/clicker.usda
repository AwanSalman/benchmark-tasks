#usda 1.0
(
    defaultPrim = "clicker"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "clicker"
{
    def "Looks"
    {
        def Material "blue"
        {
            token outputs:surface.connect = </clicker/Looks/blue/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.12, 0.25, 0.85)
                float inputs:metallic = 0
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }
    }

