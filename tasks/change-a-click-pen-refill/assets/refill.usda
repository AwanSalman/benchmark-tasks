#usda 1.0
(
    defaultPrim = "refill"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "refill"
{
    def "Looks"
    {
        def Material "brass"
        {
            token outputs:surface.connect = </refill/Looks/brass/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.65, 0.3)
                float inputs:metallic = 0.9
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "tube"
        {
            token outputs:surface.connect = </refill/Looks/tube/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.85, 0.86, 0.88)
                float inputs:metallic = 0.6
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }
    }

