    def "Looks"
    {
        def Material "brass"
        {
            token outputs:surface.connect = </refill/Looks/brass/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.65, 0.3)
                float inputs:metallic = 0.9
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "ink"
        {
            token outputs:surface.connect = </refill/Looks/ink/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.08, 0.1, 0.16)
                float inputs:metallic = 0
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "clear"
        {
            token outputs:surface.connect = </refill/Looks/clear/surface.outputs:surface>

            def Shader "surface"
