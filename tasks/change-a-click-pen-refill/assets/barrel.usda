#usda 1.0
(
    defaultPrim = "barrel"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "barrel"
{
    def "Looks"
    {
        def Material "clear"
        {
            token outputs:surface.connect = </barrel/Looks/clear/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.35, 0.7, 0.95)
                float inputs:metallic = 0
                float inputs:roughness = 0.2
                token outputs:surface
            }
        }

        def Material "clip"
        {
            token outputs:surface.connect = </barrel/Looks/clip/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.2, 0.5, 0.9)
                float inputs:metallic = 0
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }
    }

